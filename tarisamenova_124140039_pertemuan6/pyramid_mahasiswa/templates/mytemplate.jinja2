
{% extends "layout.jinja2" %}

{% block content %}
<div class="content">
    <h1>Pyramid Mahasiswa</h1>

    <p class="lead">
        Selamat datang di {{ project }}
    </p>

    <h2>Daftar Mata Kuliah</h2>

    <table border="1" cellpadding="8">
        <thead>
            <tr>
                <th>No</th>
                <th>Kode MK</th>
                <th>Nama Mata Kuliah</th>
                <th>SKS</th>
                <th>Semester</th>
            </tr>
        </thead>

        <tbody>
            {% for mk in matakuliah %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ mk.kode_mk }}</td>
                <td>{{ mk.nama_mk }}</td>
                <td>{{ mk.sks }}</td>
                <td>{{ mk.semester }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5">Belum ada data mata kuliah.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock content %}
